# Database (Coolify MariaDB / MySQL)
DB_HOST=
DB_PORT=3306
DB_NAME=sklospecial
DB_USER=sklo_user
DB_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# SMTP (Webglobe — produkce sklospecial.eu)
# Host: mail.webglobe.cz · Port 587 STARTTLS · User = celá adresa schránky
# From musí být @sklospecial.eu (SPF Webglobe). .cz mail = Active24 — nepoužívat jako From přes Webglobe.
SMTP_HOST=mail.webglobe.cz
SMTP_PORT=587
SMTP_USER=info@sklospecial.eu
SMTP_PASS=
MAIL_FROM=info@sklospecial.eu
MAIL_TO=info@sklospecial.eu

# App
WP_PUBLIC_URL=
# Optional absolute WP origin for create_poptavka URLs (e.g. https://sklospecial.cz)
NODE_ENV=production
PORT=3001
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_LEAD=8
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_REQUESTS=20
CORS_ORIGIN=
